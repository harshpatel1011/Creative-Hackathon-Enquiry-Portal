# ================================================================
#  Infinity Coders – Email Configuration
# ================================================================
#  Fill in your Gmail details below to enable email sending.
#
#  STEPS TO SET UP:
#  1. Open your Gmail account → myaccount.google.com/security
#  2. Enable 2-Step Verification (if not already)
#  3. Go to myaccount.google.com/apppasswords
#  4. Click "Create App Password" → name it "Infinity Coders"
#  5. Copy the 16-character password (e.g. "abcd efgh ijkl mnop")
#  6. Paste it below WITHOUT spaces (e.g. abcdefghijklmnop)
# ================================================================

# Your Gmail address (the one that sends all emails)
EMAIL_SENDER=infinitycoders.portal@gmail.com

# Gmail App Password (16 characters, NO spaces, NO quotes)
EMAIL_PASSWORD=abcdefghijklmnop

# Admin email — receives new signup notifications
ADMIN_EMAIL=admin@infinitycoders.com

# Your website URL (for email links)
APP_URL=http://localhost:5000

# Institute name shown in emails
INSTITUTE_NAME=Infinity Coders
